+ * @param {number} y - The y coordinate of the tile.
+ * @returns {Promise<ArrayBuffer|undefined>} - The stored tile bytes, or undefined if the tile is missing.
+ */
+async function getStoredZxyAttempt(pmtiles, z, x, y) {
+  const tileId = zxyToTileId(z, x, y);
+  const header = await pmtiles.cache.getHeader(pmtiles.source);
+  if (z < header.minZoom || z > header.maxZoom) {
+    return undefined;
+  }
+  let offset = header.rootDirectoryOffset;
+  let length = header.rootDirectoryLength;
+  for (let depth = 0; depth <= 3; depth++) {
+    const directory = await pmtiles.cache.getDirectory(
+      pmtiles.source,
+      offset,
+      length,
+      header,
+    );
+    const entry = findTile(directory, tileId);
+    if (!entry) {
+      return undefined;
+    }
+    if (entry.runLength > 0) {
+      const resp = await pmtiles.source.getBytes(
+        header.tileDataOffset + entry.offset,
+        entry.length,
+        undefined,
+        header.etag,
+      );
+      return resp.data;
+    }
+    offset = header.leafDirectoryOffset + entry.offset;
+    length = entry.length;
+  }
+  throw new Error('Maximum directory depth exceeded');
+}
